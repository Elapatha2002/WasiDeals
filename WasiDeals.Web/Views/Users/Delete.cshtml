@model Admin.Models.Users

@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header text-center">
            <h3 class="card-title" style="font-family: 'Source Sans Pro', sans-serif;">Delete User Confirmation</h3>
        </div>
        <div class="card-body">
            <h4>Are you sure you want to delete this user?</h4>
            <hr />
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.UserName)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.UserName)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.UserEmail)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.UserEmail)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.UserPhoneNumber)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.UserPhoneNumber)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.UserAddress)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.UserAddress)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.UserStatus)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.UserStatus)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.ModifiedById)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.ModifiedById)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.ModifiedOn)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.ModifiedOn)
                </dd>
            </dl>

        </div>
        <div class="card-footer text-center">
            <form asp-action="Delete">
                <input type="hidden" asp-for="UserId" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash-alt"></i> Delete
                </button>


                <a class="btn btn-secondary" asp-action="Index">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </form>
        </div>
    </div>
</div>
