@model IEnumerable<Admin.Models.Users>

@{
    ViewData["Title"] = "Index";
}


<div style="margin-top: 20px;">
    <p>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus" style="margin-right: 8px"></i>Add New Buyer
        </a>
    </p>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title" style="font-family: 'Source Sans Pro', sans-serif; font-size: 22px;">Users List</h3>
        </div>
        <div class="card-body">
            <table id="example1" class="table table-bordered table-striped" style="text-align: center;">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.UserName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.UserEmail)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.UserPhoneNumber)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.UserAddress)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.UserStatus)
                        </th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.UserName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UserEmail)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UserPhoneNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UserAddress)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UserStatus)
                            </td>

                            <td>
                                <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-primary btn-sm">
                                    <i class="fas fa-pen" style="margin-right: 4px;margin-left: 4px"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.UserId" class="btn btn-warning btn-sm">
                                    <i class="fas fa-eye" style="margin-right: 4px;margin-left: 4px"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash-alt" style="margin-right: 4px;margin-left: 4px"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

