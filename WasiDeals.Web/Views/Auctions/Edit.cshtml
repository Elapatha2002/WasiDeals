@model Admin.Models.Auctions

@{
    ViewData["Title"] = "Edit Auction";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header text-center">
            <h3 class="card-title" style="font-family: 'Source Sans Pro', sans-serif;">Edit Auction</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="AuctionId" />

                <div class="form-group">
                    <label asp-for="BuyerId" class="control-label"></label>
                    <input asp-for="BuyerId" class="form-control" />
                    <span asp-validation-for="BuyerId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="HighestBids" class="control-label"></label>
                    <input asp-for="HighestBids" class="form-control" />
                    <span asp-validation-for="HighestBids" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AuctionName" class="control-label"></label>
                    <input asp-for="AuctionName" class="form-control" />
                    <span asp-validation-for="AuctionName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AuctionStartDate" class="control-label"></label>
                    <input asp-for="AuctionStartDate" class="form-control" type="date" />
                    <span asp-validation-for="AuctionStartDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AuctionStartTime" class="control-label"></label>
                    <input asp-for="AuctionStartTime" class="form-control" type="time" />
                    <span asp-validation-for="AuctionStartTime" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TimeBtwItemChange" class="control-label"></label>
                    <input asp-for="TimeBtwItemChange" class="form-control" />
                    <span asp-validation-for="TimeBtwItemChange" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AuctionItems" class="control-label"></label>
                    <input asp-for="AuctionItems" class="form-control" />
                    <span asp-validation-for="AuctionItems" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AuctionStatus" class="control-label"></label>
                    <select asp-for="AuctionStatus" class="form-control">
                        <option value="">Select Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Completed">Completed</option>
                    </select>
                    <span asp-validation-for="AuctionStatus" class="text-danger"></span>
                </div>

                <div class="form-group text-center">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a class="btn btn-secondary" asp-action="Index"><i class="fas fa-arrow-left"></i> Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
