@model Admin.Models.Auctions

@{
    ViewData["Title"] = "Auction Details";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header text-center">
            <h3 class="card-title" style="font-family: 'Source Sans Pro', sans-serif;">Auction Details</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.BuyerId)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.BuyerId)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.HighestBids)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.HighestBids)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.AuctionName)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.AuctionName)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.AuctionStartDate)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.AuctionStartDate)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.AuctionStartTime)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.AuctionStartTime)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.TimeBtwItemChange)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.TimeBtwItemChange)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.AuctionItems)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.AuctionItems)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.AuctionStatus)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.AuctionStatus)
                </dd>
            </dl>
        </div>
        <div class="card-footer text-center">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.AuctionId">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a class="btn btn-secondary" asp-action="Index">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>
