@model Admin.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header text-center">
            <h3 class="card-title" style="font-family: 'Source Sans Pro', sans-serif;">Invoice Details</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.BuyerName)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.BuyerName)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.BuyerId)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.BuyerId)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.SellerName)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.SellerName)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.SellerId)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.SellerId)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.ItemName)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.ItemName)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Qty)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Qty)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.UnitPrice)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.UnitPrice)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.TotalPrice)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.TotalPrice)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Date)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Date)
                </dd>
            </dl>
        </div>
        <div class="card-footer text-center">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.InvoiceId">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a class="btn btn-secondary" asp-action="Index">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>
