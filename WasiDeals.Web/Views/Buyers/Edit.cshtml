@model Admin.Models.Buyers

@{
    ViewData["Title"] = "Edit Buyers";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header text-center">
            <h3 class="card-title" style="font-family: 'Source Sans Pro', sans-serif;">Edit Buyers</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="BuyerId" />

                <div class="form-group">
                    <label asp-for="BuyerName" class="control-label"></label>
                    <input asp-for="BuyerName" class="form-control" />
                    <span asp-validation-for="BuyerName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BuyerEmail" class="control-label"></label>
                    <input asp-for="BuyerEmail" class="form-control" type="email" />
                    <span asp-validation-for="BuyerEmail" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BuyerPhoneNumber" class="control-label"></label>
                    <input asp-for="BuyerPhoneNumber" class="form-control" type="tel" />
                    <span asp-validation-for="BuyerPhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BuyerAddress" class="control-label"></label>
                    <input asp-for="BuyerAddress" class="form-control" />
                    <span asp-validation-for="BuyerAddress" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ModifiedById" class="control-label"></label>
                    <input asp-for="ModifiedById" class="form-control" readonly />
                    <span asp-validation-for="ModifiedById" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ModifiedOn" class="control-label"></label>
                    <input asp-for="ModifiedOn" class="form-control" type="datetime" readonly />
                    <span asp-validation-for="ModifiedOn" class="text-danger"></span>
                </div>

                <div class="form-group text-center">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a class="btn btn-secondary" asp-action="Index"><i class="fas fa-arrow-left"></i> Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

