@model Admin.Models.Buyers

@{
    ViewData["Title"] = "Buyer Details";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header text-center">
            <h3 class="card-title" style="font-family: 'Source Sans Pro', sans-serif;">Buyer Details</h3>
        </div>
        <div class="card-body">
            
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.BuyerName)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.BuyerName)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.BuyerEmail)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.BuyerEmail)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.BuyerPhoneNumber)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.BuyerPhoneNumber)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.BuyerAddress)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.BuyerAddress)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.ModifiedById)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.ModifiedById)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.ModifiedOn)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.ModifiedOn)
                </dd>
            </dl>
        </div>
        <div class="card-footer text-center">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.BuyerId">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a class="btn btn-secondary" asp-action="Index">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>
