@model IEnumerable<Admin.Models.Sales>
@{
    ViewData["Title"] = "Index";
}
<div style="margin-top: 20px;">
    <p><a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus" style="margin-right: 8px"></i>Add Sale</a></p>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title" style="font-family: 'Source Sans Pro', sans-serif; font-size: 22px;">Sales List</h3>
        </div>
        <div class="card-body">
            <table id="example1" class="table table-bordered table-striped" style="text-align: center;">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.SellerId)</th>
                        <th>@Html.DisplayNameFor(model => model.BuyerId)</th>
                        <th>@Html.DisplayNameFor(model => model.ItemId)</th>
                        <th>@Html.DisplayNameFor(model => model.Qty)</th>
                        <th>@Html.DisplayNameFor(model => model.PaymentStatus)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.SellerId)</td>
                            <td>@Html.DisplayFor(modelItem => item.BuyerId)</td>
                            <td>@Html.DisplayFor(modelItem => item.ItemId)</td>
                            <td>@Html.DisplayFor(modelItem => item.Qty)</td>
                            <td>@Html.DisplayFor(modelItem => item.PaymentStatus)</td>

                            <td><a asp-action="Edit" asp-route-id="@item.SalesId" class="btn btn-primary btn-sm"><i class="fas fa-pen" style="margin-right: 8px;margin-left: 8px"></i></a>
                                <a asp-action="Details" asp-route-id="@item.SalesId" class="btn btn-warning btn-sm"><i class="fas fa-eye" style="margin-right: 8px;margin-left: 8px"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.SalesId" class="btn btn-danger btn-sm"><i class="fas fa-trash-alt" style="margin-right: 8px;margin-left: 8px"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

