@model Admin.Models.Items

@{
    ViewData["Title"] = "Item Details";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header text-center">
            <h3 class="card-title" style="font-family: 'Source Sans Pro', sans-serif;">Item Details</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.SellerId)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.SellerId)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.SellerName)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.SellerName)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.ItemName)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.ItemName)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.ItemDescription)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.ItemDescription)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.MinimumBid)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.MinimumBid)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Picture)
                </dt>
                <dd class="col-sm-8">
                    @if (!string.IsNullOrEmpty(Model.Picture))
                    {
                        <img src="@Url.Content(Model.Picture)" alt="Item Image" class="img-fluid" style="max-height: 200px; max-width: 100%;" />
                    }
                    else
                    {
                        <span>No image available</span>
                    }
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Qty)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Qty)
                </dd>
            </dl>
        </div>
        <div class="card-footer text-center">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.ItemId">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a class="btn btn-secondary" asp-action="Index">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>
